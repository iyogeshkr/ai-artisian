# ─── Image Generation Backend ────────────────────────────────────────────────
# The frontend now uses Pollinations.ai (free, no key needed) for image generation.
# The Python backend is still available for local/GPU inference if preferred.

# Hugging Face model name to use for local inference
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional: Hugging Face token (only needed for gated/private models)
HF_INFERENCE_TOKEN=

# Set to "true" to use Hugging Face Inference API instead of local Diffusers
HF_USE_REMOTE_INFERENCE=false

# Optional: override the HF Inference API endpoint
# HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell

# Timeout for remote API requests (seconds)
HF_REMOTE_TIMEOUT_SECONDS=240

# Optional: fixed seed for reproducible results
HF_IMAGE_SEED=

# Generation timeout for local inference (seconds)
GENERATION_TIMEOUT_SECONDS=180
