# AI Artisan backend environment template
# Do not commit real secrets. Configure production values in Railway.

NODE_ENV=development
PORT=8000

# Public frontend origin(s), comma-separated. Production example:
# ALLOWED_ORIGINS=https://aiartisan.app,https://www.aiartisan.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Clerk
CLERK_SECRET_KEY=sk_test_replace_this
# Optional PEM public key from Clerk Dashboard for JWT verification
CLERK_JWT_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Hugging Face
HUGGING_FACE_API_KEY=hf_replace_this
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell
HF_TIMEOUT_MS=30000
HF_MAX_RETRIES=2
HF_RETRY_DELAY_MS=5000
