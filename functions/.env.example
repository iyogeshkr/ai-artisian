HF_TIMEOUT_MS=30000
HF_MAX_RETRIES=2
HF_RETRY_DELAY_MS=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGINS=https://ai-artisan.web.app,https://ai-artisan.firebaseapp.com
NODE_ENV=production
