HUGGING_FACE_API_KEY=hf_...
CLERK_SECRET_KEY=sk_...
CLERK_PUBLISHABLE_KEY=pk_...
# Optional: PEM public key from Clerk Dashboard for networkless JWT verification
CLERK_JWT_KEY=
