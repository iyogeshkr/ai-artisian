# AI Artisan backend wrapper environment template
# Keep this aligned with functions/.env.example because backend/server.js
# delegates to functions/src/server.js.

NODE_ENV=development
PORT=8000

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000

CLERK_SECRET_KEY=sk_test_replace_this
CLERK_JWT_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

HUGGING_FACE_API_KEY=hf_replace_this
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_INFERENCE_ENDPOINT=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.1-schnell
HF_TIMEOUT_MS=30000
HF_MAX_RETRIES=2
HF_RETRY_DELAY_MS=5000
